<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.Light">

        <item name="android:colorBackground">#F8F9FF</item>
        <item name="android:isLightTheme">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Status bar-->
        <item name="colorPrimaryDark">#E8E8F0</item>

        <!-- Tool/Nav bars -->
        <item name="colorPrimary">#F0EFF7</item>
        <item name="colorOnPrimary">#1B1B21</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>

        <!-- List/Media items -->
        <item name="colorSecondary">#F0EFF7</item>
        <item name="colorOnSecondary">#4E516B</item>
        <item name="android:textColorSecondary">#45464F</item>
        <item name="boxStrokeColor">#C5C6D0</item>

        <!-- Active media item -->
        <item name="alpha">1</item>
        <item name="colorSecondaryVariant">#535E9F</item>
        <item name="android:textColorTertiary">#1B1B21</item>

        <!-- Popup menu -->
        <item name="colorSurface">#F8F9FF</item>
        <item name="colorOnSurface">#1B1B21</item>
        <item name="colorPrimarySurface">#E8E8F0</item>
        <item name="colorOnPrimarySurface">#1B1B21</item>
        <item name="popupMenuStyle">@style/AppTheme.Light.PopupMenuStyle</item>

        <item name="colorAccent">#535E9F</item>
        <item name="rippleColor">#3C535E9F</item>

        <item name="android:textColorHint">#757680</item>

        <item name="colorControlNormal">#444650</item>
        <item name="colorControlActivated">#535E9F</item>

    </style>

    <style name="AppTheme.Light.PopupMenuStyle" parent="Theme.Utils.Base.PopupMenuStyle">
        <item name="android:textColor">?colorOnPrimary</item>
    </style>

</resources>
